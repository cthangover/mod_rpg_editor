{
  "id": "rpg_editor",
  "name": "RPG Map Editor",
  "version": "1.0.0",
  "author": "ct",
  "description": "RPG map editor for model v2 (plan 12.4): a palette by shape, the map in the game's own top-down and isometric projections, placements (own and foreign, as patches), strokes, collision, spawn, teleport links, undo and a byte-stable save; encounters when rpg__battles is mounted.",
  "category": "tools, editor",
  "sources": [
    "src/**/*.cs"
  ],
  "test_sources": [
    "tests/*.cs"
  ],
  "depends": [
    "rpg>=1",
    "effects_base>=1",
    "characters_base>=1",
    "items_base>=1",
    "tools_base>=1",
    "ui_base>=1",
    "scenario_tools_base>=1"
  ],
  "test_suites": [
    {
      "id": "edit",
      "activate": [
        "--itest=rpg_editor_edit"
      ]
    },
    {
      "id": "companion",
      "activate": [
        "--itest=rpg_companion_edit"
      ]
    },
    {
      "id": "tutorial",
      "activate": [
        "--itest=tutorial_first_game"
      ]
    },
    {
      "id": "tutorial_play",
      "activate": [
        "--itest=tutorial_first_game_play"
      ]
    },
    {
      "id": "areas",
      "activate": [
        "--itest=rpg_editor_areas"
      ]
    },
    {
      "id": "events",
      "activate": [
        "--itest=rpg_map_events"
      ]
    },
    {
      "id": "lighting",
      "activate": [
        "--itest=map_lights"
      ]
    },
    {
      "id": "darkness",
      "activate": [
        "--itest=free_lights"
      ]
    }
  ],
  "integrations": [
    {
      "id": "lights",
      "with": [
        "light_editor"
      ]
    }
  ]
}
